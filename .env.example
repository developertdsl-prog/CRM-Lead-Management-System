# ==============================================================================
# ENVIRONMENT CONFIGURATION: CRM & Lead Management System
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
APP_NAME="CRM & Lead Management System"
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# PostgreSQL Database (Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://crm_user:crm_secure_password_123@localhost:5432/crm_db?schema=public

# Redis & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Authentication & JWT Secrets
# Run: openssl rand -base64 48 to generate secure secrets
JWT_ACCESS_SECRET=crm_jwt_access_secret_super_secure_random_key_min_32_chars_long_12345
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=crm_jwt_refresh_secret_super_secure_random_key_min_32_chars_long_67890
JWT_REFRESH_EXPIRES_IN=7d
PASSWORD_HASH_ROUNDS=12

# Cookie Secret
COOKIE_SECRET=crm_cookie_session_secret_key_random_characters_987654321

# Rate Limiting (Throttler)
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=120

# CORS
CORS_ORIGIN=http://localhost:3000

# File Storage (S3 / MinIO compatible)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=crm_minio_admin
S3_SECRET_KEY=crm_minio_secret_key_12345
S3_BUCKET_NAME=crm-attachments
S3_FORCE_PATH_STYLE=true

# Email / SMTP (Nodemailer / SES / Resend)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CRM System <noreply@crmsystem.local>"

# Super Admin / Initial Seed
SEED_ADMIN_EMAIL=admin@crmenterprise.com
SEED_ADMIN_PASSWORD=AdminStrongPassword!123
SEED_ORG_NAME="Acme Global Corporation"
SEED_ORG_SLUG="acme-global"

# Logging
LOG_LEVEL=debug
