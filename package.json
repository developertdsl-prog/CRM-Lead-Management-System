{
  "name": "crm-lead-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade multi-tenant CRM and Lead Management System",
  "author": "Antigravity Engineering",
  "license": "UNLICENSED",
  "scripts": {
    "build": "pnpm --filter @crm/* --filter crm-api --filter crm-web build",
    "dev": "pnpm --parallel --filter crm-api --filter crm-web dev",
    "dev:api": "pnpm --filter crm-api dev",
    "dev:web": "pnpm --filter crm-web dev",
    "lint": "pnpm --recursive lint",
    "test": "pnpm --recursive test",
    "db:generate": "pnpm --filter @crm/database generate",
    "db:push": "pnpm --filter @crm/database db:push",
    "db:migrate": "pnpm --filter @crm/database db:migrate",
    "db:seed": "pnpm --filter @crm/database db:seed",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.4.5"
  },
  "packageManager": "pnpm@10.34.3"
}
